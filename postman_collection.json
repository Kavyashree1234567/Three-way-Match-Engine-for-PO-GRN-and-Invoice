{
  "info": {
    "name": "Three-Way Match Engine",
    "description": "API collection for uploading PO, GRN, and Invoice documents and checking match status.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000"
    },
    {
      "key": "documentId",
      "value": ""
    },
    {
      "key": "poNumber",
      "value": "PO-1001"
    }
  ],
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "health"
          ]
        }
      }
    },
    {
      "name": "Upload PO",
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "documentType",
              "value": "po",
              "type": "text"
            },
            {
              "key": "file",
              "type": "file",
              "src": ""
            }
          ]
        },
        "url": {
          "raw": "{{baseUrl}}/documents/upload",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "documents",
            "upload"
          ]
        }
      }
    },
    {
      "name": "Upload GRN",
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "documentType",
              "value": "grn",
              "type": "text"
            },
            {
              "key": "file",
              "type": "file",
              "src": ""
            }
          ]
        },
        "url": {
          "raw": "{{baseUrl}}/documents/upload",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "documents",
            "upload"
          ]
        }
      }
    },
    {
      "name": "Upload Invoice",
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "documentType",
              "value": "invoice",
              "type": "text"
            },
            {
              "key": "file",
              "type": "file",
              "src": ""
            }
          ]
        },
        "url": {
          "raw": "{{baseUrl}}/documents/upload",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "documents",
            "upload"
          ]
        }
      }
    },
    {
      "name": "Get Parsed Document",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/documents/{{documentId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "documents",
            "{{documentId}}"
          ]
        }
      }
    },
    {
      "name": "Get Match By PO Number",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/match/{{poNumber}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "match",
            "{{poNumber}}"
          ]
        }
      }
    }
  ]
}
